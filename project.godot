; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Ultrablast Turbo"
config/description="Arcade flyer: lock on and crunch through crystals, rifts and enemy jets while the Iris closes the sky."
config/version="godot-port-1 (from pc-v4.2)"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.5", "Forward Plus")
boot_splash/bg_color=Color(0.0392157, 0.0431373, 0.133333, 1)
config/icon="res://icon.svg"

[autoload]

U="*res://scripts/core/util.gd"
Ctl="*res://scripts/core/ctl.gd"
AudioSys="*res://scripts/core/audio.gd"
REC="*res://scripts/core/rec.gd"
World="*res://scripts/game/world.gd"
P="*res://scripts/game/ship.gd"
FX="*res://scripts/game/fx.gd"
Enemies="*res://scripts/game/enemies.gd"
Threats="*res://scripts/game/threats.gd"
ST="*res://scripts/game/style.gd"
HOM="*res://scripts/game/homing.gd"
BL="*res://scripts/game/blast.gd"
Coach="*res://scripts/ui/coach.gd"
TUT="*res://scripts/game/tutorial.gd"
GAME="*res://scripts/game/game.gd"

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[gui]

theme/custom="res://scenes/ui/theme.tres"

